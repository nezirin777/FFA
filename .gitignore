# Bin/binディレクトリとその中身を除外する
#[Bb]in/

__pycache__/
*.pyc
images/
他ゲー参考/
追加/
移植計画書/

save_data/*
!save_data/.htaccess
!save_data/champion.json
!save_data/protected_users/
!save_data/protected_users/**

# 実データを含む日次バックアップはGitで管理しない
backups/*
!backups/.htaccess
**/banklog/*.*
**/charalog/*.*
**/charalog2/*.*
**/item/*.*
# 現行VerのマスターデータはGitで管理する
!data/weapon.json
!data/armor.json
!data/accessory.json
!data/tac.json
!data/monsters/
!data/monsters/**
!data/chocobo/
!data/chocobo/**

**/souko/**/*
**/syoku/*.*
**/sousin/*.*

**/change_data/**/

旧版_ver1/datalog/**
旧版_ver1/savelog/**
旧版_ver2/datalog/**
旧版_ver2/savelog/**
